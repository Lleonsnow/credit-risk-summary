      },
      "encoding": {
        "y": {
          "field": "dim_sort",
          "type": "nominal",
          "title": null,
          "axis": null
        },
        "yOffset": {
          "field": "date_label",
          "sort": {
            "field": "report_date",
            "op": "min"
          }
        },
        "color": {
          "field": "date_label",
          "title": null,
          "sort": {
            "field": "report_date",
            "op": "min"
          },
          "scale": {
            "range": [
              "#5b6472",
              "#3dceb4"
            ]
          },
          "legend": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "opacity": 0
          },
          "encoding": {
            "x": {
              "field": "npl_share",
              "type": "quantitative",
              "title": null,
              "axis": {
                "format": ".0%",
                "tickCount": 4
              },
              "stack": null
            }
          }
        },
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 3
          },
          "encoding": {
            "x": {
              "field": "anim",
              "type": "quantitative",
              "title": null,
              "axis": {
                "format": ".0%",
                "tickCount": 4
              },
              "stack": null
            },
            "tooltip": [
              {
                "field": "dimension_value",
                "title": "Значение"
              },
              {
                "field": "date_label",
                "title": "Срез"
              },
              {
                "field": "npl_share",
